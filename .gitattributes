# Unreal Engine Git LFS & Attributes Configuration
# =================================================

# Unreal Engine Binary Assets (Tracked by Git LFS & Lockable)
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable

